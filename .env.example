# Frontend configuration (exposed to the browser — public values only).
# Copy to .env.local for local development and add the same variables in Vercel/Netlify.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service-role key here. Edge Functions receive SUPABASE_SERVICE_ROLE_KEY
# automatically from Supabase; it must not appear in any VITE_ variable.
